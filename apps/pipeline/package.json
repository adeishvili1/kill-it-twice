{
  "name": "kit-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Replication pipeline: Postgres -> Elasticsearch + RabbitMQ with backfill + incremental sync",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
